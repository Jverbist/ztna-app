# FortiGate REST API connection settings
FORTIGATE_HOST=10.60.10.1
# NOTE: this lab's FortiGate admin GUI/API is served on 10443, not the
# default 443 - confirm your own FortiGate's admin port before changing this.
FORTIGATE_PORT=10443
FORTIGATE_TOKEN=changeme-put-your-api-token-here
FORTIGATE_VERIFY_TLS=false

# How often the backend polls the FortiGate API (seconds)
POLL_INTERVAL=10
